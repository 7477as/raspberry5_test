## 10. 构建系统

嵌入式 MCU 例外允许**裸 Makefile**（参考代码本身就这么写）。  
普通 Linux / Pi 项目仍按 `10-c.mdc` 走 **CMake + `build_run.sh`**。

**CMake 风格模板**（推荐用于本仓库的 c/embed/）：

```cmake
cmake_minimum_required(VERSION 3.16)
project(stdf_demo VERSION 1.0.0 LANGUAGES C)

set(CMAKE_C_STANDARD 11)
set(CMAKE_C_EXTENSIONS OFF)

if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "" FORCE)
endif()

find_package(Threads REQUIRED)
# 可选依赖：用 pkg_check_modules 检测，缺失时 fallback
pkg_check_modules(GPIOD libgpiod)

add_executable(stdf_demo
    main.c
    stdf_main/stdf.c
    stdf_os/stdf_os.c
    stdf_app/stdf_app.c
    stdf_app/stdf_app_led.c
    # ...
)

target_include_directories(stdf_demo PRIVATE
    stdf_main
    stdf_os
    stdf_app
)

target_compile_options(stdf_demo PRIVATE -Wall -Wextra -Wpedantic -Wshadow)
target_link_libraries(stdf_demo PRIVATE Threads::Threads)

if(GPIOD_FOUND)
    target_compile_definitions(stdf_demo PRIVATE STDF_DEMO_HAS_GPIOD)
    target_link_libraries(stdf_demo PRIVATE ${GPIOD_LIBRARIES})
    target_include_directories(stdf_demo PRIVATE ${GPIOD_INCLUDE_DIRS})
endif()
```

`build_run.sh` 必须按 `10-c.mdc` 标准模板（`run` / `build` / `clean` / `rebuild` + `BUILD_TYPE` + `NORUN`）。

